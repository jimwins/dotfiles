[Desktop Entry]
Version=1.0
Terminal=false
Type=Application
Name=Fastmail
MimeType=x-scheme-handler/mailto;x-scheme-handler/chromium;
Exec=/home/jimw/.local/bin/chromium-pwa-launch Fastmail nkbljeindhmekmppbpgebpjebkjbmfaj %U
Icon=/home/jimw/.local/share/icons/hicolor/256x256/apps/chrome-nkbljeindhmekmppbpgebpjebkjbmfaj-Default.png
StartupWMClass=crx_nkbljeindhmekmppbpgebpjebkjbmfaj
Actions=Calendar;Compose;Contacts;Mail

[Desktop Action Calendar]
Name=Calendar
Exec=/home/jimw/.local/bin/chromium-pwa-launch Fastmail nkbljeindhmekmppbpgebpjebkjbmfaj --app-launch-url-for-shortcuts-menu-item=https://app.fastmail.com/calendar/

[Desktop Action Compose]
Name=Compose
Exec=/home/jimw/.local/bin/chromium-pwa-launch Fastmail nkbljeindhmekmppbpgebpjebkjbmfaj --app-launch-url-for-shortcuts-menu-item=https://app.fastmail.com/mail/Inbox/compose

[Desktop Action Contacts]
Name=Contacts
Exec=/home/jimw/.local/bin/chromium-pwa-launch Fastmail nkbljeindhmekmppbpgebpjebkjbmfaj --app-launch-url-for-shortcuts-menu-item=https://app.fastmail.com/contacts/

[Desktop Action Mail]
Name=Mail
Exec=/home/jimw/.local/bin/chromium-pwa-launch Fastmail nkbljeindhmekmppbpgebpjebkjbmfaj --app-launch-url-for-shortcuts-menu-item=https://app.fastmail.com/mail/Inbox
